GOOGLE_API_KEY=your_google_api_key_here
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Opt-in protected staging. Supply a separately generated runtime secret when true.
# Token: 43-256 URL-safe characters; generate with secrets.token_urlsafe(32).
# Never put this token in browser code, URLs, Git, or image build arguments.
STAGING_AUTH_ENABLED=false
STAGING_AUTH_TOKEN=
# Aggregate fixed-window attempts across authenticated HTTP routes, independent of IP.
# Active only when staging auth is enabled; process-local, not a monetary cap.
STAGING_BUDGET_REQUESTS=10
STAGING_BUDGET_WINDOW_SECONDS=60
# In staging set FRONTEND_ORIGINS explicitly, or empty for CLI-only access.
# Wildcards are rejected. Local development origins above are unchanged.

# Relative paths resolve from the repository root, not the working directory.
# Generate explicitly with python -m src.ingest before starting the API.
RAG_INDEX_PATH=data/index/portfolio.json

# Settings are loaded at startup; restart after changes.
# Finite seconds in [0.01, 120]. Independent of provider transport timeouts.
CHAT_DEADLINE_SECONDS=40
# Remaining numeric settings are positive integers.
# SDK HTTP timeouts in milliseconds, not an overall application deadline.
GEMINI_EMBEDDING_TIMEOUT_MS=10000
GEMINI_GENERATION_TIMEOUT_MS=20000
# auto preserves SDK networking. Use ipv4 only for a direct network with broken IPv6.
GEMINI_NETWORK_POLICY=auto
# Combined thinking + visible output ceiling, integer in [1, 65536].
# Initial settings for evaluation; not claimed to be optimal.
GEMINI_MAX_OUTPUT_TOKENS=1024
# gemini-3.8-flash supports LOW, MEDIUM, HIGH; MINIMAL is not supported.
GEMINI_THINKING_LEVEL=LOW
CHAT_MAX_BODY_BYTES=8192
CHAT_MAX_CONCURRENT=4
CHAT_RATE_LIMIT_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_RATE_LIMIT_MAX_CLIENTS=1024
